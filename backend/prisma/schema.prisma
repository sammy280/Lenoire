generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                @id @default(cuid())
  email                  String?               @unique
  passwordHash           String?
  pin                    String?
  name                   String
  role                   Role
  loginType              LoginType
  isActive               Boolean               @default(true)
  failedAttempts         Int                   @default(0)
  lockedUntil            DateTime?
  lastLogin              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  attendance             Attendance[]
  auditLogs              AuditLog[]
  barUpdates             BarOrder[]            @relation("BarStaffUpdates")
  cashierBills           Bill[]
  creditPaymentsReceived CreditPayment[]       @relation("CreditReceiver")
  creditApprovals        CreditSale[]          @relation("CreditApprover")
  dailyReports           DailyReport[]
  approvedDeletes        DeleteRequest[]       @relation("ApprovedDeleteBy")
  deleteRequests         DeleteRequest[]       @relation("RequestedBy")
  deliveries             Delivery[]
  profile                EmployeeProfile?
  expenses               Expense[]
  firedRecord            FiredEmployee?        @relation("FiredEmployee")
  firedBy                FiredEmployee[]       @relation("FiredBy")
  kitchenUpdates         KitchenOrder[]        @relation("KitchenStaffUpdates")
  notifications          Notification[]
  createdOrders          Order[]               @relation("CreatedByOrders")
  assignedOrders         Order[]               @relation("WaiterOrders")
  passwordResets         PasswordReset[]
  cashierPayments        Payment[]
  payrollEmployee        Payroll[]             @relation("EmployeePayroll")
  payrollPaid            Payroll[]             @relation("PaidByPayroll")
  approvedPunishments    Punishment[]          @relation("ApprovedBy")
  punishments            Punishment[]          @relation("PunishedEmployee")
  punishmentsBy          Punishment[]          @relation("PunishedBy")
  purchases              Purchase[]
  purchaseOrdersCreated  PurchaseOrder[]       @relation("PurchaseOrderCreator")
  requisitionsCreated    Requisition[]         @relation("RequisitionRequester")
  requisitionsReviewed   Requisition[]         @relation("RequisitionReviewer")
  sessions               Session[]
  shifts                 Shift[]
  reconciliations        StockReconciliation[]
}

model EmployeeProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  profilePicture     String?
  nationalId         String?
  phone              String?
  address            String?
  employmentDate     DateTime
  status             EmployeeStatus      @default(ACTIVE)
  emergencyContact   String?
  emergencyPhone     String?
  baseSalary         Decimal?            @default(0) @db.Decimal(10, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  documents          Document[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  performanceMetrics PerformanceMetric[]
}

model Document {
  id         String          @id @default(cuid())
  profileId  String
  name       String
  type       String
  url        String
  uploadedAt DateTime        @default(now())
  profile    EmployeeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  type        String
  icon        String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id               String             @id @default(cuid())
  name             String
  description      String?
  price            Decimal            @db.Decimal(10, 2)
  categoryId       String
  image            String?
  isAvailable      Boolean            @default(true)
  isFeatured       Boolean            @default(false)
  preparationTime  Int?
  allergens        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  onlineOrderItems OnlineOrderItem[]
  orderItems       OrderItem[]
  category         Category           @relation(fields: [categoryId], references: [id])
  inventoryLinks   ProductInventory[]
  promotionItems   PromotionItem[]
  reviews          Review[]
}

model RestaurantTable {
  id           String        @id @default(cuid())
  name         String        @unique
  status       TableStatus   @default(AVAILABLE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  orders       Order[]
  reservations Reservation[]
  seats        Seat[]
}

model Seat {
  id         String          @id @default(cuid())
  tableId    String
  label      String
  isOccupied Boolean         @default(false)
  orders     Order[]
  table      RestaurantTable @relation(fields: [tableId], references: [id])
}

model Order {
  id            String          @id @default(cuid())
  orderNumber   String          @unique
  tableId       String
  seatId        String
  waiterId      String
  createdById   String
  status        OrderStatus     @default(PENDING)
  notes         String?
  cancelReason  String?
  cancelledBy   String?
  isSent        Boolean         @default(false)
  billRequested Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  barOrder      BarOrder?
  bill          Bill?
  kitchenOrder  KitchenOrder?
  createdBy     User            @relation("CreatedByOrders", fields: [createdById], references: [id])
  seat          Seat            @relation(fields: [seatId], references: [id])
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  waiter        User            @relation("WaiterOrders", fields: [waiterId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  notes       String?
  type        String
  batchNumber Int     @default(1)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model KitchenOrder {
  id           String      @id @default(cuid())
  orderId      String      @unique
  status       OrderStatus @default(PENDING)
  staffId      String?
  notes        String?
  startedAt    DateTime?
  readyAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  currentBatch Int         @default(1)
  order        Order       @relation(fields: [orderId], references: [id])
  staff        User?       @relation("KitchenStaffUpdates", fields: [staffId], references: [id])
}

model BarOrder {
  id           String      @id @default(cuid())
  orderId      String      @unique
  status       OrderStatus @default(PENDING)
  staffId      String?
  notes        String?
  startedAt    DateTime?
  readyAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  currentBatch Int         @default(1)
  order        Order       @relation(fields: [orderId], references: [id])
  staff        User?       @relation("BarStaffUpdates", fields: [staffId], references: [id])
}

model Bill {
  id          String     @id @default(cuid())
  billNumber  String     @unique
  orderId     String     @unique
  subtotal    Decimal    @db.Decimal(10, 2)
  tax         Decimal    @default(0) @db.Decimal(10, 2)
  discount    Decimal    @default(0) @db.Decimal(10, 2)
  total       Decimal    @db.Decimal(10, 2)
  status      BillStatus @default(NOT_GENERATED)
  billType    BillType   @default(NORMAL)
  generatedBy String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cashier     User?      @relation(fields: [generatedBy], references: [id])
  order       Order      @relation(fields: [orderId], references: [id])
  payment     Payment?
}

model Payment {
  id            String        @id @default(cuid())
  receiptNumber String        @unique
  billId        String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  cashierId     String
  notes         String?
  mixedDetails  Json?
  createdAt     DateTime      @default(now())
  bill          Bill          @relation(fields: [billId], references: [id])
  cashier       User          @relation(fields: [cashierId], references: [id])
}

model InventoryItem {
  id                 String               @id @default(cuid())
  name               String
  category           String
  quantity           Decimal              @db.Decimal(10, 3)
  unit               String
  costPrice          Decimal              @db.Decimal(10, 2)
  sellingPrice       Decimal?             @db.Decimal(10, 2)
  supplierId         String?
  minimumStock       Decimal              @db.Decimal(10, 3)
  isLiquor           Boolean              @default(false)
  bottleVolume       Decimal?             @db.Decimal(10, 3)
  fullBottles        Int?                 @default(0)
  halfBottles        Int?                 @default(0)
  quarterBottles     Int?                 @default(0)
  fullBottlePrice    Decimal?             @db.Decimal(10, 2)
  halfBottlePrice    Decimal?             @db.Decimal(10, 2)
  quarterBottlePrice Decimal?             @db.Decimal(10, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])
  productLinks       ProductInventory[]
  reconciliations    ReconciliationItem[]
  movements          StockMovement[]
}

model ProductInventory {
  id              String        @id @default(cuid())
  productId       String
  inventoryItemId String
  quantity        Decimal       @db.Decimal(10, 3)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model StockMovement {
  id              String            @id @default(cuid())
  inventoryItemId String
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 3)
  previousQty     Decimal           @db.Decimal(10, 3)
  newQty          Decimal           @db.Decimal(10, 3)
  reason          String?
  reference       String?
  userId          String?
  createdAt       DateTime          @default(now())
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id])
}

model StockReconciliation {
  id         String               @id @default(cuid())
  date       DateTime
  reviewedBy String
  notes      String?
  createdAt  DateTime             @default(now())
  items      ReconciliationItem[]
  reviewer   User                 @relation(fields: [reviewedBy], references: [id])
}

model ReconciliationItem {
  id               String              @id @default(cuid())
  reconciliationId String
  inventoryItemId  String
  openingStock     Decimal             @db.Decimal(10, 3)
  closingStock     Decimal             @db.Decimal(10, 3)
  expectedStock    Decimal             @db.Decimal(10, 3)
  difference       Decimal             @db.Decimal(10, 3)
  explanation      String?
  inventoryItem    InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  reconciliation   StockReconciliation @relation(fields: [reconciliationId], references: [id])
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  contact   String?
  email     String?
  address   String?
  products  String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  inventory InventoryItem[]
  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(cuid())
  supplierId  String
  product     String
  quantity    Decimal  @db.Decimal(10, 3)
  unit        String
  unitCost    Decimal  @db.Decimal(10, 2)
  totalCost   Decimal  @db.Decimal(10, 2)
  isPaid      Boolean  @default(false)
  purchasedBy String
  notes       String?
  createdAt   DateTime @default(now())
  purchaser   User     @relation(fields: [purchasedBy], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])
}

model Attendance {
  id          String    @id @default(cuid())
  userId      String
  date        DateTime
  clockIn     DateTime
  clockOut    DateTime?
  hoursWorked Decimal?  @db.Decimal(5, 2)
  shiftId     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shift       Shift?    @relation(fields: [shiftId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Shift {
  id         String       @id @default(cuid())
  userId     String
  shiftType  ShiftType
  shiftName  String
  date       DateTime
  startTime  DateTime
  endTime    DateTime
  assignedBy String
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attendance Attendance[]
  user       User         @relation(fields: [userId], references: [id])
}

model Payroll {
  id          String   @id @default(cuid())
  employeeId  String
  amount      Decimal  @db.Decimal(10, 2)
  period      String
  daysWorked  Int?
  hoursWorked Decimal? @db.Decimal(8, 2)
  overtime    Decimal? @db.Decimal(8, 2)
  deductions  Decimal? @default(0) @db.Decimal(10, 2)
  paidById    String
  notes       String?
  paymentDate DateTime @default(now())
  createdAt   DateTime @default(now())
  employee    User     @relation("EmployeePayroll", fields: [employeeId], references: [id])
  paidBy      User     @relation("PaidByPayroll", fields: [paidById], references: [id])
}

model Customer {
  id             String         @id @default(cuid())
  name           String?
  phone          String?        @unique
  email          String?        @unique
  passwordHash   String?
  address        String?
  loyaltyPoints  Int            @default(0)
  totalSpent     Decimal        @default(0) @db.Decimal(12, 2)
  lastVisit      DateTime?
  isVerified     Boolean        @default(false)
  otpCode        String?
  otpExpiry      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orders         OnlineOrder[]
  reviews        Review[]
  savedAddresses SavedAddress[]
}

model SavedAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String?
  address    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Reservation {
  id              String            @id @default(cuid())
  customerName    String
  phone           String
  tableId         String
  guestCount      Int
  reservationDate DateTime
  reservationTime String
  status          ReservationStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  table           RestaurantTable   @relation(fields: [tableId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  recordedBy  String
  receipt     String?
  createdAt   DateTime @default(now())
  recorder    User     @relation(fields: [recordedBy], references: [id])
}

model Punishment {
  id              String           @id @default(cuid())
  employeeId      String
  submittedBy     String
  reason          String
  type            String
  amount          Decimal?         @db.Decimal(10, 2)
  status          PunishmentStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  approver        User?            @relation("ApprovedBy", fields: [approvedBy], references: [id])
  employee        User             @relation("PunishedEmployee", fields: [employeeId], references: [id])
  submitter       User             @relation("PunishedBy", fields: [submittedBy], references: [id])
}

model FiredEmployee {
  id         String   @id @default(cuid())
  employeeId String   @unique
  role       Role
  reason     String
  firedById  String
  firedAt    DateTime @default(now())
  notes      String?
  employee   User     @relation("FiredEmployee", fields: [employeeId], references: [id])
  firedBy    User     @relation("FiredBy", fields: [firedById], references: [id])
}

model DeleteRequest {
  id              String              @id @default(cuid())
  tableName       String
  recordId        String
  reason          String
  requestedBy     String
  status          DeleteRequestStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  approver        User?               @relation("ApprovedDeleteBy", fields: [approvedBy], references: [id])
  requester       User                @relation("RequestedBy", fields: [requestedBy], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  role        String?
  action      String
  description String
  tableName   String?
  recordId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PerformanceMetric {
  id              String          @id @default(cuid())
  profileId       String
  date            DateTime
  ordersHandled   Int             @default(0)
  ordersServed    Int             @default(0)
  revenue         Decimal         @default(0) @db.Decimal(10, 2)
  attendanceScore Decimal         @default(0) @db.Decimal(5, 2)
  hoursWorked     Decimal         @default(0) @db.Decimal(5, 2)
  createdAt       DateTime        @default(now())
  profile         EmployeeProfile @relation(fields: [profileId], references: [id])
}

model OnlineOrder {
  id                  String            @id @default(cuid())
  orderNumber         String            @unique
  customerId          String?
  guestName           String?
  guestPhone          String?
  guestEmail          String?
  deliveryType        DeliveryType      @default(DELIVERY)
  deliveryAddress     String?
  deliveryFee         Decimal           @default(0) @db.Decimal(10, 2)
  subtotal            Decimal           @db.Decimal(10, 2)
  discount            Decimal           @default(0) @db.Decimal(10, 2)
  total               Decimal           @db.Decimal(10, 2)
  status              OnlineOrderStatus @default(ORDER_RECEIVED)
  paymentMethod       PaymentMethod     @default(CASH)
  isPaid              Boolean           @default(false)
  notes               String?
  estimatedTime       Int?
  loyaltyPointsEarned Int               @default(0)
  loyaltyPointsUsed   Int               @default(0)
  promoCode           String?
  promotionId         String?
  erpOrderId          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  delivery            Delivery?
  customer            Customer?         @relation(fields: [customerId], references: [id])
  promotion           Promotion?        @relation(fields: [promotionId], references: [id])
  items               OnlineOrderItem[]
}

model OnlineOrderItem {
  id            String      @id @default(cuid())
  onlineOrderId String
  productId     String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  notes         String?
  onlineOrder   OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])
}

model Delivery {
  id          String      @id @default(cuid())
  orderId     String      @unique
  riderId     String?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  order       OnlineOrder @relation(fields: [orderId], references: [id])
  rider       User?       @relation(fields: [riderId], references: [id])
}

model Promotion {
  id          String          @id @default(cuid())
  name        String
  description String?
  code        String?         @unique
  type        String
  value       Decimal         @db.Decimal(10, 2)
  minOrder    Decimal?        @db.Decimal(10, 2)
  maxDiscount Decimal?        @db.Decimal(10, 2)
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean         @default(true)
  usageLimit  Int?
  usageCount  Int             @default(0)
  createdAt   DateTime        @default(now())
  orders      OnlineOrder[]
  items       PromotionItem[]
}

model PromotionItem {
  id          String    @id @default(cuid())
  promotionId String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  promotion   Promotion @relation(fields: [promotionId], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  customerId  String
  productId   String?
  rating      Int
  comment     String?
  type        String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String
  points      Int
  type        String
  reference   String?
  description String?
  createdAt   DateTime @default(now())
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Backup {
  id        String   @id @default(cuid())
  filename  String
  size      BigInt
  createdBy String
  status    String   @default("completed")
  notes     String?
  createdAt DateTime @default(now())
}

model CreditSale {
  id            String          @id @default(cuid())
  billId        String?
  customerName  String
  customerPhone String?
  customerRole  String?
  amount        Decimal         @db.Decimal(10, 2)
  amountPaid    Decimal         @default(0) @db.Decimal(10, 2)
  balance       Decimal         @db.Decimal(10, 2)
  status        CreditStatus    @default(PENDING)
  approvedById  String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payments      CreditPayment[]
  approvedBy    User?           @relation("CreditApprover", fields: [approvedById], references: [id])
}

model CreditPayment {
  id           String     @id @default(cuid())
  creditSaleId String
  amount       Decimal    @db.Decimal(10, 2)
  paidAt       DateTime   @default(now())
  receivedById String
  notes        String?
  creditSale   CreditSale @relation(fields: [creditSaleId], references: [id])
  receivedBy   User       @relation("CreditReceiver", fields: [receivedById], references: [id])
}

model DailyReport {
  id               String   @id @default(cuid())
  date             DateTime
  totalCash        Decimal  @default(0) @db.Decimal(10, 2)
  totalMomo        Decimal  @default(0) @db.Decimal(10, 2)
  totalCard        Decimal  @default(0) @db.Decimal(10, 2)
  totalCredit      Decimal  @default(0) @db.Decimal(10, 2)
  totalExpenses    Decimal  @default(0) @db.Decimal(10, 2)
  barSales         Decimal  @default(0) @db.Decimal(10, 2)
  kitchenSales     Decimal  @default(0) @db.Decimal(10, 2)
  recoveryAmount   Decimal  @default(0) @db.Decimal(10, 2)
  creditBreakdown  Json?
  expenseBreakdown Json?
  notes            String?
  isFinalized      Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        User     @relation(fields: [createdById], references: [id])
}

model Requisition {
  id            String              @id @default(cuid())
  title         String
  category      RequisitionCategory @default(OTHER)
  notes         String?
  status        RequisitionStatus   @default(PENDING)
  urgency       String              @default("NORMAL")
  requestedById String
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  purchaseOrder PurchaseOrder?
  requestedBy   User                @relation("RequisitionRequester", fields: [requestedById], references: [id])
  reviewedBy    User?               @relation("RequisitionReviewer", fields: [reviewedById], references: [id])
  items         RequisitionItem[]
}

model RequisitionItem {
  id            String      @id @default(cuid())
  requisitionId String
  name          String
  quantity      Decimal     @db.Decimal(10, 2)
  unit          String      @default("unit")
  estimatedCost Decimal?    @db.Decimal(10, 2)
  notes         String?
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id            String      @id @default(cuid())
  requisitionId String      @unique
  supplier      String?
  totalCost     Decimal     @default(0) @db.Decimal(10, 2)
  status        String      @default("PENDING")
  notes         String?
  createdById   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     User        @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  requisition   Requisition @relation(fields: [requisitionId], references: [id])
}

enum Role {
  ADMIN
